<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{%- endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{%- endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="stylesheet" href="https://rzcrewgarage.com/cdn/shop/t/76/assets/base.css">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'component-card.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}">
  <link rel="stylesheet" href="https://rzcrewgarage.com/cdn/shop/t/76/assets/flickity.css">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
  <script src="https://rzcrewgarage.com/cdn/shop/t/76/assets/flickity.pkgd.js" defer></script>

  <style>
    :root {
      --page-width: 146rem;
      --font-body-family: "Space Grotesk", sans-serif;
      --font-heading-family: "Space Grotesk", sans-serif;
      --color-primary-red: #bf1000;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: var(--font-body-family);
      background-color: #0b0f19;
      color: #ffffff;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
  </style>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}
</body>
</html>
