<div id="CartDrawer" class="cart-drawer-overlay hidden">
  <div class="cart-drawer">
    <div class="cart-drawer__header">
      <h2>Shopping Cart (<span id="CartCount">0</span>)</h2>
      <button class="cart-drawer__close" id="CartDrawerClose">&times;</button>
    </div>
    <div class="cart-drawer__body" id="CartDrawerItems">
      <p class="cart-drawer__empty">Your cart is currently empty.</p>
    </div>
    <div class="cart-drawer__footer">
      <div class="cart-drawer__subtotal">
        <span>Subtotal:</span>
        <strong id="CartSubtotal">$0.00</strong>
      </div>
      <p class="cart-drawer__shipping-note">Taxes and shipping calculated at checkout.</p>
      <a href="/checkout" class="btn btn--primary btn--full">Proceed to Checkout</a>
    </div>
  </div>
</div>