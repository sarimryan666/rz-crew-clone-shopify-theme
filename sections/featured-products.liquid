{% schema %}
{
  "name": "Featured Products",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "The RZCREW Products!" }
  ]
}
{% endschema %}

<div class="featured-products-section" style="padding: 40px 0; background: #000000;">
  <div class="container">
    <div class="section-title">
      <span>{{ section.settings.title }}</span>
      <a href="/collections/all" class="view-all">VIEW ALL CATALOG &rarr;</a>
    </div>

    <div class="product-grid">
      {% assign products_to_show = collections.all.products | limit: 4 %}
      {% if products_to_show.size > 0 %}
        {% for product in products_to_show %}
          <div class="product-card">
            {% if product.compare_at_price > product.price %}
              <span class="badge-sale">SALE</span>
            {% endif %}
            <a href="{{ product.url }}" class="card-img-wrap">
              <img src="{{ product.featured_image | image_url: width: 450 }}" alt="{{ product.title }}">
            </a>
            <div class="card-info">
              <span class="vendor">{{ product.vendor }}</span>
              <a href="{{ product.url }}" class="title">{{ product.title }}</a>
              <div class="price-row">
                <span class="price">${{ product.price | money_without_currency }} CAD</span>
                {% if product.compare_at_price > product.price %}
                  <span class="compare-price">${{ product.compare_at_price | money_without_currency }}</span>
                {% endif %}
              </div>
              <button class="btn-add-cart">ADD TO CART</button>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Dynamic Fallback Items matching original RZCREW website layout screenshot -->
        <div class="product-card">
          <div class="card-img-wrap">
            <img src="https://rzcrewgarage.com/cdn/shop/files/RZCREW_Racing_Block_Guard_58937b52-97ec-4a96-af44-642a2b58f911.jpg" alt="Rzcrew Racing - Billet Block Guard">
          </div>
          <div class="card-info">
            <span class="vendor">RZCREW RACING</span>
            <a href="/products/rzcrew-racing-billet-block-guard-toyota-1nz-fe-rz-bg-1nz" class="title">Rzcrew Racing - Billet Block Guard - Toyota 1NZ-FE</a>
            <div class="price-row"><span class="price">$130.00 CAD</span></div>
            <button class="btn-add-cart">ADD TO CART</button>
          </div>
        </div>
        <div class="product-card">
          <div class="card-img-wrap">
            <img src="https://rzcrewgarage.com/cdn/shop/files/CL7_Reinforced_Clutch_pedal_bracket2.jpg" alt="Clutch Pedal Reinforcement Bracket">
          </div>
          <div class="card-info">
            <span class="vendor">RZCREW RACING</span>
            <a href="/products/rzcrew-racing-clutch-pedal-reinforcement-bracket-honda-accord-euro-r-cl7-rzc-cl7-cpb" class="title">Rzcrew Racing - Clutch Pedal Reinforcement Bracket - Honda Accord CL7</a>
            <div class="price-row"><span class="price">$39.00 CAD</span></div>
            <button class="btn-add-cart">ADD TO CART</button>
          </div>
        </div>
        <div class="product-card">
          <span class="badge-sale">SALE</span>
          <div class="card-img-wrap">
            <img src="https://rzcrewgarage.com/cdn/shop/products/rzcrew-racing-titanium-steering-wheel-bolts-rzcrew-1.jpg" alt="Titanium Steering Wheel Bolts">
          </div>
          <div class="card-info">
            <span class="vendor">RZCREW RACING</span>
            <a href="/products/rzcrew-racing-titanium-steering-wheel-bolts-rz-sttb-m512" class="title">Rzcrew Racing - Titanium Steering Wheel Bolts</a>
            <div class="price-row"><span class="price">$21.10 CAD</span><span class="compare-price">$24.00</span></div>
            <button class="btn-add-cart">ADD TO CART</button>
          </div>
        </div>
        <div class="product-card">
          <span class="badge-sale">SALE</span>
          <div class="card-img-wrap">
            <img src="https://rzcrewgarage.com/cdn/shop/products/RZCREW_Racing_Airstream_Intake_manifold_Mazda_MX5_Miata_NA6_NB6_Front_2f842696-b494-46f3-a190-a4c76c1e140a.jpg" alt="Airstream Intake Manifold">
          </div>
          <div class="card-info">
            <span class="vendor">RZCREW RACING</span>
            <a href="/products/rzcrew-racing-airstream-intake-manifold-mazda-mx-5-miata-roadster-na6ce-air-m-na6ce" class="title">Rzcrew Racing - Airstream Intake Manifold - Mazda Miata NA6CE</a>
            <div class="price-row"><span class="price">$490.00 CAD</span><span class="compare-price">$520.00</span></div>
            <button class="btn-add-cart">ADD TO CART</button>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
