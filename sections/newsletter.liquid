{% schema %}
{ "name": "Newsletter", "settings": [] }
{% endschema %}

<div class="newsletter-section" style="background: #000000; padding: 35px 0; border-top: 1px solid #1e293b;">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
    <div style="display: flex; align-items: center; gap: 15px;">
      <i class="fa fa-envelope" style="font-size: 28px; color: #229bac;"></i>
      <div>
        <strong style="font-size: 16px; color: #ffffff;">Our newsletter</strong><br>
        <small style="color: #94a3b8;">Subscribe to our newsletter and receive special offers</small>
      </div>
    </div>
    <form style="display: flex; gap: 10px; max-width: 500px; flex-grow: 1;">
      <input type="email" placeholder="Your email..." style="flex-grow: 1; padding: 12px 15px; background: #0f172a; border: 1px solid #334155; color: #fff; border-radius: 4px; outline: none;">
      <button type="submit" class="btn-cyan">Subscribe</button>
    </form>
  </div>
</div>
