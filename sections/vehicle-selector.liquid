{% schema %}
{ "name": "Vehicle Selector", "settings": [] }
{% endschema %}

<div class="vehicle-selector-bar">
  <div class="container vehicle-flex">
    <span class="vehicle-label"><i class="fa fa-car"></i> SELECT YOUR VEHICLE FITMENT:</span>
    <select class="fitment-select">
      <option value="">Select Make</option>
      <option value="toyota">Toyota</option>
      <option value="honda">Honda</option>
      <option value="nissan">Nissan</option>
      <option value="mazda">Mazda</option>
      <option value="porsche">Porsche</option>
    </select>
    <select class="fitment-select">
      <option value="">Select Model</option>
      <option value="accord">Accord Euro R CL7</option>
      <option value="350z">350Z Z33</option>
      <option value="miata">MX-5 Miata NA6CE</option>
      <option value="86">86 ZN6</option>
    </select>
    <select class="fitment-select">
      <option value="">Select Engine</option>
      <option value="1nzfe">1NZ-FE 1.5L</option>
      <option value="k20a">K20A 2.0L</option>
      <option value="vq35de">VQ35DE 3.5L</option>
    </select>
    <button class="btn-cyan search-fitment-btn">SEARCH FITMENT</button>
  </div>
</div>

<style>
  .vehicle-selector-bar { background: #0a0e17; border-bottom: 1px solid #1e293b; padding: 14px 0; }
  .vehicle-flex { display: flex; align-items: center; gap: 15px; flex-wrap: wrap; }
  .vehicle-label { font-size: 13px; font-weight: 700; color: #229bac; display: flex; align-items: center; gap: 8px; }
  .fitment-select { flex-grow: 1; min-width: 180px; background: #1e293b; color: #ffffff; border: 1px solid #334155; padding: 10px 12px; border-radius: 4px; font-size: 13px; font-family: inherit; outline: none; }
  .search-fitment-btn { font-size: 13px; padding: 10px 24px; }
</style>
