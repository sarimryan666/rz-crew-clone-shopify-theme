<script>
  (function() {
    class ProductDescriptionTabs2fe292e extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-product-tab-2fe292e');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          const header = tab.querySelector('.ai-product-tab-header-2fe292e');
          
          header.addEventListener('click', () => {
            this.toggleTab(tab);
          });

          header.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.toggleTab(tab);
            }
          });
        });
      }

      toggleTab(tab) {
        const isActive = tab.classList.contains('active');
        const header = tab.querySelector('.ai-product-tab-header-2fe292e');
        
        tab.classList.toggle('active');
        header.setAttribute('aria-expanded', !isActive);
      }
    }

    customElements.define('product-description-tabs-2fe292e', ProductDescriptionTabs2fe292e);
  })();
</script>
<!-- bespoke shipping widget -->
<script type="text/javascript">
  var cc = null;
  var countryName = null;
  
  function getCountry() {
    var cc = null;
    $.ajax({
      url: '//ip2c.org/self',
      type: 'get',
      async: false,
      success: function(data) {
        if (typeof data != 'undefined' && data.startsWith('1')) {
          var d = data.split(';');
          cc = d[1];
          countryName = d[3];
        }
      }
    });
    return cc;
  }
  
  function getRate(cc) {
    var qty = $('#quantity-input-template--20303925543094__main-product').val() || $('#quantity').val();
    var vid = $('form[data-type="add-to-cart-form"] input[name="id"]').val() || $('#txtBespokeVariantID').val();
    var pid = $('#txtBespokeProductID').val();

    var requestObj = {"origin":{"country":null,"postal_code":null,"province":null,"city":"","name":null,"address1":"","address2":"","address3":null,"phone":"","fax":null,"address_type":null,"company_name":""},
                      "destination":{"country":cc,"postal_code":null,"province":null,"city":"","name":"","address1":"","address2":"","address3":null,"phone":"","fax":null,"address_type":null,"company_name":""},"items":[
                        {"name":"","sku":"","quantity":qty,"grams":"","price":0,"vendor":"","requires_shipping":true,"taxable":true,"fulfillment_service":"","properties":null,"product_id":pid,"variant_id":vid}
                      ],"currency":null};

    $('.lblBespokeRate').html('Working...');
    
    $.ajax({
      type: "POST",
      beforeSend: function(request) {
        request.setRequestHeader("HTTP_X_STORE_NAME", "rzcrew.myshopify.com");
        request.setRequestHeader("HTTP_X_STORE_TOKEN", "593ed82f3aef444d8363a6465f1fcdd7a8b14c40");
      },
      url: "https://parcel-intelligence.com/cs/api_ex.php",
      data: JSON.stringify(requestObj),
      dataType: 'json',
      contentType: 'application/json',
      processData: false,
      success: function(msg) {
        var hasRate = false;
        var cheapestRate = null;
        $.each(msg.rates, function(k,rate) {
          if (cheapestRate === null || rate.total_price < cheapestRate) cheapestRate = rate.total_price;
          hasRate = true;
        });
        if (hasRate) {
          cheapestRate = (cheapestRate/100);
          cheapestRate = cheapestRate.toFixed(2);
          console.log('cheapestRate: '+cheapestRate);
          
          var rateHtml = 'Shipping to '+countryName+' from <span class="money">$'+cheapestRate+' SGD</span>';
          $('.lblBespokeRate').html(rateHtml);
          $('.divBespokeRate').css('display', 'flex');

          // Trigger conversion for the newly injected rate
          if (typeof Currency !== 'undefined' && typeof Currency.cookie !== 'undefined' && typeof Currency.cookie.read === 'function') {
            var cookieCurrency = Currency.cookie.read();
            if (cookieCurrency && cookieCurrency !== 'SGD') {
               console.log("Shipping widget: Converting fetched SGD to", cookieCurrency);
               Currency.convertAll("SGD", cookieCurrency, ".money");
            }
          }
        }
      }
    });
  }
  
  $(document).ready(function() {
    cc = getCountry();
    console.log('detected country: '+cc);
    
    if (cc !== null) {
      //get rate
      getRate(cc);
    }

    $('.quantity-input-plus, .quantity-input-minus').click(function() {
      setTimeout(function() {
        getRate(cc);
      },500);
    });

    $(document).on('change', 'variant-selects, variant-radios', function() {
      setTimeout(function() {
        getRate(cc);
      }, 500);
    });
  });
</script>
