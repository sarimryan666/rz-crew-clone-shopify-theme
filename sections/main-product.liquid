{% schema %}
{ "name": "Main Product", "settings": [] }
{% endschema %}

<div class="product-page-wrap" style="background: #ffffff; color: #1e293b; padding: 40px 0;">
  <div class="container">
    <div class="breadcrumb" style="font-size: 13px; color: #229bac; margin-bottom: 25px; font-weight: 500;">
      <a href="/">Home</a> &gt; <a href="/collections/rzcrew-racing">Rzcrew Racing</a> &gt; <span>{{ product.title | default: "RZCREW RACING - BILLET BLOCK GUARD - TOYOTA 1NZ-FE" }}</span>
    </div>

    <div class="product-main-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">
      <!-- Product Image Gallery -->
      <div class="product-gallery">
        <div class="main-img" style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 20px; text-align: center;">
          <img src="{{ product.featured_image | default: 'https://rzcrewgarage.com/cdn/shop/files/RZCREW_Racing_Block_Guard_58937b52-97ec-4a96-af44-642a2b58f911.jpg' }}" alt="{{ product.title }}" style="max-height: 500px; margin: 0 auto; object-fit: contain;">
        </div>
      </div>

      <!-- Product Details & Add to Cart -->
      <div class="product-details">
        <h1 style="font-size: 24px; font-weight: 700; color: #a823a0; text-transform: uppercase; margin-bottom: 10px;">
          {{ product.title | default: "RZCREW RACING - BILLET BLOCK GUARD - TOYOTA 1NZ-FE" }}
        </h1>

        <div class="meta" style="font-size: 13px; color: #64748b; margin-bottom: 15px; line-height: 1.6;">
          <p>Brand: <strong style="color: #0f172a;">{{ product.vendor | default: "Rzcrew Racing" }}</strong></p>
          <p>SKU: <strong>{{ product.selected_or_first_available_variant.sku | default: "RZ-BG-1NZ" }}</strong></p>
          <p>Availability: <span style="color: #16a34a; font-weight: 600;">Usually ships from the manufacturer within 10 to 20 days</span></p>
        </div>

        <div class="price-box" style="margin: 20px 0;">
          <span style="font-size: 26px; font-weight: 700; color: #229bac;">${{ product.price | default: 13000 | money_without_currency }} CAD</span>
          <p style="font-size: 12px; color: #64748b; margin-top: 4px;">Shipping to Pakistan from $85.72 CAD</p>
        </div>

        <!-- Add to Cart Controls -->
        <div class="cart-actions" style="display: flex; gap: 15px; align-items: center; margin-bottom: 30px;">
          <div class="qty-picker" style="display: flex; border: 1px solid #cbd5e1; border-radius: 4px; overflow: hidden;">
            <button style="padding: 10px 15px; background: #f1f5f9; border: none; font-weight: 700; cursor: pointer;">-</button>
            <input type="text" value="1" style="width: 45px; text-align: center; border: none; font-weight: 600;">
            <button style="padding: 10px 15px; background: #f1f5f9; border: none; font-weight: 700; cursor: pointer;">+</button>
          </div>
          <button class="btn-cyan" style="flex-grow: 1; padding: 14px; font-size: 15px;">ADD TO CART</button>
        </div>

        <!-- Accordion Details -->
        <div class="product-accordions" style="border-top: 1px solid #e2e8f0; padding-top: 20px;">
          <details open style="border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 15px;">
            <summary style="font-weight: 700; font-size: 15px; cursor: pointer; color: #0f172a;">Description</summary>
            <div style="font-size: 14px; color: #475569; margin-top: 10px; line-height: 1.6;">
              <p>The RZCREW Racing Billet Block Guard strengthens the cylinder walls of your Toyota 1NZ-FE engine, preventing cylinder sleeve flex and failure under high boost or elevated RPM conditions. Precision CNC-machined from 6061-T6 aluminum for maximum durability and optimum coolant flow.</p>
              <ul style="margin-left: 20px; margin-top: 10px;">
                <li>Fits Toyota 1NZ-FE engines</li>
                <li>High-grade 6061-T6 billet aluminum construction</li>
                <li>Precision CAD designed and CNC machined</li>
                <li>Essential engine protection for turbocharged or high-compression builds</li>
              </ul>
            </div>
          </details>

          <details style="border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 15px;">
            <summary style="font-weight: 700; font-size: 15px; cursor: pointer; color: #0f172a;">Taxes & Shipping</summary>
            <div style="font-size: 14px; color: #475569; margin-top: 10px;">
              Worldwide express shipping available via DHL/FedEx. Import duties & taxes calculated at checkout.
            </div>
          </details>

          <details style="border-bottom: 1px solid #e2e8f0; padding-bottom: 15px;">
            <summary style="font-weight: 700; font-size: 15px; cursor: pointer; color: #0f172a;">Fitting Information</summary>
            <div style="font-size: 14px; color: #475569; margin-top: 10px;">
              Direct press-fit installation into open deck block. Professional engine builder installation recommended.
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>
