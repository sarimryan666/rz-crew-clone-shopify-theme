{% schema %}
{ "name": "Focus Product Showcase", "settings": [] }
{% endschema %}

<div class="focus-product-section" style="padding: 45px 0; background: #000000; border-bottom: 1px solid #1e293b;">
  <div class="container">
    <div class="section-title"><span>Focus Game</span></div>
    <div class="focus-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; background: #0f172a; border-radius: 8px; padding: 30px; border: 1px solid #1e293b; align-items: center;">
      <div class="focus-media">
        <img src="https://rzcrewgarage.com/cdn/shop/files/02b3c08c817aa463ecfd2265859f5a55M.jpg" alt="Result Japan NEO86 Bodykit" style="width: 100%; border-radius: 6px;">
      </div>
      <div class="focus-details">
        <span style="color: #229bac; font-weight: 700; font-size: 13px; text-transform: uppercase;">RESULT JAPAN</span>
        <h3 style="font-size: 24px; font-weight: 700; color: #ffffff; margin: 10px 0 15px;">Result Japan NEO86 Bodykit - Toyota - 86 ZN6</h3>
        <p style="color: #229bac; font-size: 26px; font-weight: 700; margin-bottom: 20px;">$10,660.00 CAD</p>
        <div style="display: flex; gap: 15px; align-items: center; margin-bottom: 20px;">
          <input type="number" value="1" style="width: 60px; padding: 10px; background: #1e293b; border: 1px solid #334155; color: #fff; border-radius: 4px; font-weight: 600;">
          <a href="/products/result-japan-neo86-bodykit-toyota-86-zn6" class="btn-cyan" style="padding: 12px 28px; flex-grow: 1;">ADD TO CART</a>
        </div>
        <button class="btn-purple" style="width: 100%;">Buy with Shop Pay</button>
      </div>
    </div>
  </div>
</div>
