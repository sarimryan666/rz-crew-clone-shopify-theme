{% schema %}
{ "name": "Universal Categories", "settings": [] }
{% endschema %}

<div class="universal-products-section" style="padding: 40px 0; background: #000000;">
  <div class="container">
    <div class="section-title">
      <span>Shop for Universal Products!</span>
      <a href="/collections/all" class="view-all">VIEW ALL &rarr;</a>
    </div>

    <div class="univ-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
      <div class="univ-card" style="position: relative; border-radius: 6px; overflow: hidden; background: linear-gradient(180deg, #1e293b, #0f172a); border: 1px solid #334155; text-align: center; padding: 20px 10px;">
        <img src="https://rzcrewgarage.com/cdn/shop/files/seats-rzcrew.jpg" alt="Seats" style="max-height: 140px; margin: 0 auto 15px; object-fit: contain;">
        <a href="/collections/all" class="btn-cyan" style="width: 80%; font-size: 12px;">Seats</a>
      </div>
      <div class="univ-card" style="position: relative; border-radius: 6px; overflow: hidden; background: linear-gradient(180deg, #1e293b, #0f172a); border: 1px solid #334155; text-align: center; padding: 20px 10px;">
        <img src="https://rzcrewgarage.com/cdn/shop/files/steering-wheels-rzcrew.jpg" alt="Steering Wheels" style="max-height: 140px; margin: 0 auto 15px; object-fit: contain;">
        <a href="/collections/steering-wheels" class="btn-cyan" style="width: 80%; font-size: 12px;">Steering Wheels</a>
      </div>
      <div class="univ-card" style="position: relative; border-radius: 6px; overflow: hidden; background: linear-gradient(180deg, #1e293b, #0f172a); border: 1px solid #334155; text-align: center; padding: 20px 10px;">
        <img src="https://rzcrewgarage.com/cdn/shop/files/pedals-rzcrew.jpg" alt="Pedals" style="max-height: 140px; margin: 0 auto 15px; object-fit: contain;">
        <a href="/collections/pedals" class="btn-cyan" style="width: 80%; font-size: 12px;">Pedals</a>
      </div>
      <div class="univ-card" style="position: relative; border-radius: 6px; overflow: hidden; background: linear-gradient(180deg, #1e293b, #0f172a); border: 1px solid #334155; text-align: center; padding: 20px 10px;">
        <img src="https://rzcrewgarage.com/cdn/shop/files/safety-harness-rzcrew.jpg" alt="Safety Harness" style="max-height: 140px; margin: 0 auto 15px; object-fit: contain;">
        <a href="/collections/harnesses" class="btn-cyan" style="width: 80%; font-size: 12px;">Safety Harness</a>
      </div>
    </div>
  </div>
</div>
