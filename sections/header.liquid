{% schema %}
{ "name": "Header", "settings": [] }
{% endschema %}

<header class="site-header">
  <div class="top-announcement-bar">
    <div class="container announcement-content">
      <span>ASIA'S LARGEST JDM & PERFORMANCE PARTS STORE • FAST WORLDWIDE SHIPPING • 980+ BRANDS</span>
    </div>
  </div>

  <div class="main-header">
    <div class="container header-grid">
      <!-- Logo -->
      <div class="logo-col">
        <a href="/" class="site-logo">
          <img src="https://rzcrewgarage.com/cdn/shop/files/logo_1.jpg?v=1764570861&width=170" alt="RZ Crew Garage" width="170" height="40">
        </a>
      </div>

      <!-- Search Box with Teal Button -->
      <div class="search-col">
        <form action="/search" method="get" class="search-form">
          <select name="vendor" class="search-vendor-select">
            <option value="">All Vendors</option>
            <option value="Rzcrew Racing">Rzcrew Racing</option>
            <option value="Hayashi Racing">Hayashi Racing</option>
            <option value="Mishimoto">Mishimoto</option>
            <option value="CSF Race">CSF Race</option>
            <option value="BBS Japan">BBS Japan</option>
            <option value="Result Japan">Result Japan</option>
            <option value="VenturiX">VenturiX</option>
          </select>
          <input type="text" name="q" placeholder="Search by chassis (EG6), engine code (1NZFE) or products..." class="search-input">
          <button type="submit" class="search-btn"><i class="fa fa-search"></i> Search</button>
        </form>
      </div>

      <!-- Contact & Account Icons -->
      <div class="user-actions-col">
        <div class="contact-info">
          <span><i class="fa fa-phone"></i> +6583150016</span>
          <small>sales@rzcrewgarage.com</small>
        </div>
        <div class="currency-picker">
          <select class="currency-select">
            <option value="CAD">CAD ($)</option>
            <option value="USD">USD ($)</option>
            <option value="SGD">SGD ($)</option>
          </select>
        </div>
        <a href="/account" class="icon-link"><i class="fa fa-user"></i></a>
        <a href="/cart" class="icon-link cart-link"><i class="fa fa-shopping-bag"></i> <span class="cart-badge">0</span></a>
      </div>
    </div>
  </div>

  <!-- Navigation Menu Bar -->
  <nav class="nav-bar">
    <div class="container nav-links">
      <a href="/" class="nav-item active">HOME</a>
      <a href="/collections/all" class="nav-item">SHOP BY PRODUCT TYPE <i class="fa fa-chevron-down"></i></a>
      <a href="/collections/rzcrew-racing" class="nav-item">RZCREW RACING</a>
      <a href="/collections/good-deal" class="nav-item highlight-red">GOOD DEALS!</a>
      <a href="/collections/secret-stash" class="nav-item">SECRET STASH</a>
      <a href="/collections/wheels" class="nav-item">WHEELS</a>
      <a href="/collections/cooling" class="nav-item">COOLING</a>
      <a href="/pages/wholesale-program" class="nav-item">DISTRIBUTOR PROGRAM</a>
      <a href="/pages/about-us" class="nav-item">ABOUT US</a>
    </div>
  </nav>
</header>

<style>
  .site-header { background: #000000; border-bottom: 1px solid #1f242d; }
  .top-announcement-bar { background: #bf1000; color: #ffffff; text-align: center; font-size: 12px; font-weight: 700; padding: 6px 0; letter-spacing: 0.5px; }
  .main-header { padding: 15px 0; }
  .header-grid { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .logo-col img { height: 40px; width: auto; }
  .search-col { flex-grow: 1; max-width: 650px; }
  .search-form { display: flex; border: 1px solid #334155; border-radius: 4px; overflow: hidden; background: #0f172a; }
  .search-vendor-select { background: #1e293b; color: #ffffff; border: none; padding: 10px 12px; font-size: 13px; font-family: inherit; outline: none; border-right: 1px solid #334155; }
  .search-input { flex-grow: 1; background: transparent; border: none; padding: 10px 15px; color: #ffffff; font-size: 14px; outline: none; font-family: inherit; }
  .search-btn { background: #229bac; color: #ffffff; border: none; padding: 10px 22px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 13px; }
  .search-btn:hover { background: #1a7d8b; }
  .user-actions-col { display: flex; align-items: center; gap: 18px; color: #ffffff; font-size: 13px; }
  .contact-info { display: flex; flex-direction: column; font-weight: 600; font-size: 12px; line-height: 1.2; text-align: right; }
  .contact-info small { color: #94a3b8; font-weight: 400; }
  .currency-select { background: #1e293b; color: #ffffff; border: 1px solid #334155; padding: 6px 10px; border-radius: 4px; font-size: 12px; outline: none; }
  .icon-link { color: #ffffff; font-size: 18px; position: relative; }
  .cart-badge { position: absolute; top: -8px; right: -10px; background: #229bac; color: #fff; font-size: 10px; font-weight: 700; border-radius: 50%; padding: 2px 6px; }
  .nav-bar { background: #090d16; border-top: 1px solid #1e293b; border-bottom: 1px solid #1e293b; }
  .nav-links { display: flex; align-items: center; gap: 24px; overflow-x: auto; padding: 12px 15px; }
  .nav-item { color: #cbd5e1; font-size: 13px; font-weight: 600; white-space: nowrap; display: flex; align-items: center; gap: 4px; }
  .nav-item:hover, .nav-item.active { color: #229bac; }
  .nav-item.highlight-red { color: #ff3b30; }
</style>
