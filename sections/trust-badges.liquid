{% schema %}
{ "name": "Trust Badges", "settings": [] }
{% endschema %}

<div class="trust-badges-section" style="padding: 25px 0; background: #000000; border-top: 1px solid #1e293b; border-bottom: 1px solid #1e293b;">
  <div class="container">
    <div class="badges-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px;">
      <div class="badge-pill" style="background: #ffffff; color: #1e293b; border-radius: 30px; padding: 12px 20px; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 13px;">
        <i class="fa fa-plane" style="color: #229bac; font-size: 18px;"></i>
        <div><strong>GLOBAL SHIPPING</strong><br><small style="color: #64748b; font-weight: 400;">Fast worldwide delivery</small></div>
      </div>
      <div class="badge-pill" style="background: #ffffff; color: #1e293b; border-radius: 30px; padding: 12px 20px; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 13px;">
        <i class="fa fa-check-circle" style="color: #229bac; font-size: 18px;"></i>
        <div><strong>AUTHENTIC GUARANTEE</strong><br><small style="color: #64748b; font-weight: 400;">100% genuine parts</small></div>
      </div>
      <div class="badge-pill" style="background: #ffffff; color: #1e293b; border-radius: 30px; padding: 12px 20px; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 13px;">
        <i class="fa fa-headset" style="color: #229bac; font-size: 18px;"></i>
        <div><strong>DEDICATED SUPPORT</strong><br><small style="color: #64748b; font-weight: 400;">Expert technical staff</small></div>
      </div>
      <div class="badge-pill" style="background: #ffffff; color: #1e293b; border-radius: 30px; padding: 12px 20px; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 13px;">
        <i class="fa fa-tag" style="color: #229bac; font-size: 18px;"></i>
        <div><strong>BEST PRICES</strong><br><small style="color: #64748b; font-weight: 400;">Direct manufacturer deals</small></div>
      </div>
    </div>
  </div>
</div>
